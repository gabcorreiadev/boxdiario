# Endereço público do site (sem barra no final). Configure na Netlify em
# Site configuration > Environment variables.
# Enquanto não tiver domínio: https://SEU-SITE.netlify.app
NEXT_PUBLIC_SITE_URL=

# URL "raw" do broadcast.json no GitHub (opcional). Se vazio, usa data/broadcast.json.
# Só funciona com repositório público.
BROADCAST_URL=
